; NVT Equilibration MDP file
; Canonical ensemble (constant volume, constant temperature)

; run control
integrator = md
dt = 0.002
nsteps = 50000  ; 100 ps

; output control
nstlog = 500
nstenergy = 500
nstxout = 0
nstxout-compressed = 500

; neighbour searching
nstlist = 10
ns_type = grid
rlist = 1.0

; electrostatics
coulombtype = PME
rcoulomb = 1.0
epsilon-r = 1

; van der Waals
rvdw = 1.0
DispCorr = EnerPres

; temperature control (NVT ensemble)
Tcoupl = V-rescale
tau_t = 0.1 0.1
ref_t = 310 310
tc-grps = Protein Non-Protein

; pressure control
Pcoupl = no

; velocity generation
gen-vel = yes
gen-temp = 310
gen-seed = 42

; constraints
constraints = h-bonds
constraint_algorithm = lincs
lincs_iter = 1
lincs_order = 4
