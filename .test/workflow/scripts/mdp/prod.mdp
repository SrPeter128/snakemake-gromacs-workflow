; Production MD MDP file
; Main simulation phase with checkpoint capability for long runs

; run control
integrator = md
dt = 0.002
nsteps = 500000  ; 1000 ps = 1 ns (adjust for longer runs)

; output control
nstlog = 1000
nstenergy = 1000
nstxout = 0
nstxout-compressed = 1000

; neighbour searching
nstlist = 10
ns_type = grid
rlist = 1.0

; electrostatics
coulombtype = PME
rcoulomb = 1.0
epsilon-r = 1

; van der Waals
rvdw = 1.0
DispCorr = EnerPres

; temperature control
Tcoupl = V-rescale
tau_t = 0.1 0.1
ref_t = 310 310
tc-grps = Protein Non-Protein

; pressure control
Pcoupl = Parrinello-Rahman
Pref = 1.0
tau_p = 2.0
compressibility = 4.5e-5
refcoord_scaling = com

; velocity generation
gen-vel = no

; constraints
constraints = h-bonds
constraint_algorithm = lincs
lincs_iter = 1
lincs_order = 4

; Checkpoint settings for restart capability
nstcheckpoint = 5000  ; Write checkpoint every 10 ps
